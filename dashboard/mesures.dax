// =====================================================================
//  Mesures DAX — dashboard Open Data Logement
//  Les tables importées depuis Neon s'appellent « open_data_logement xxx » :
//  à cause de l'espace, DAX exige des apostrophes autour du nom de table.
//  À créer dans une table de mesures vide nommée « _Mesures »
//  (Accueil → Entrer des données → table vide → renommer « _Mesures »).
//  Pré-requis : 'open_data_logement dim_date' marquée comme table de dates (colonne `date`).
// =====================================================================


// ---------------------------------------------------------------------
//  MARCHÉ IMMOBILIER ('open_data_logement fct_ventes')
// ---------------------------------------------------------------------

Nb ventes =
COUNTROWS ( 'open_data_logement fct_ventes' )

// La médiane est recalculée sur les ventes filtrées : juste à tout niveau
// (commune, département, année, mois, type de logement…)
Prix m² médian =
MEDIAN ( 'open_data_logement fct_ventes'[prix_m2] )

Prix médian =
MEDIAN ( 'open_data_logement fct_ventes'[prix] )

Surface médiane =
MEDIAN ( 'open_data_logement fct_ventes'[surface_m2] )


// --- Comparaison à l'année précédente --------------------------------

// Vide quand l'année en cours n'a pas de ventes (ex. 2026 dans dim_date) :
// sinon la N-1 irait chercher 2025 et créerait une ligne fantôme à -100 %.
Nb ventes N-1 =
IF (
    NOT ISBLANK ( [Nb ventes] ),
    CALCULATE ( [Nb ventes], SAMEPERIODLASTYEAR ( 'open_data_logement dim_date'[date] ) )
)

// HASONEVALUE : renvoie vide quand aucune année précise n'est filtrée
// (ligne Total d'un tableau), où la comparaison N-1 n'aurait pas de sens.
Évol. ventes vs N-1 =
IF (
    HASONEVALUE ( 'open_data_logement dim_date'[annee] ),
    DIVIDE ( [Nb ventes] - [Nb ventes N-1], [Nb ventes N-1] )
)

Prix m² médian N-1 =
IF (
    NOT ISBLANK ( [Prix m² médian] ),
    CALCULATE ( [Prix m² médian], SAMEPERIODLASTYEAR ( 'open_data_logement dim_date'[date] ) )
)

Évol. prix m² vs N-1 =
IF (
    HASONEVALUE ( 'open_data_logement dim_date'[annee] ),
    DIVIDE ( [Prix m² médian] - [Prix m² médian N-1], [Prix m² médian N-1] )
)


// --- Tendances --------------------------------------------------------

// Lisse la saisonnalité (pics de ventes en été)
Nb ventes 12 mois glissants =
CALCULATE (
    [Nb ventes],
    DATESINPERIOD ( 'open_data_logement dim_date'[date], MAX ( 'open_data_logement dim_date'[date] ), -12, MONTH )
)

Prix m² médian 12 mois glissants =
CALCULATE (
    [Prix m² médian],
    DATESINPERIOD ( 'open_data_logement dim_date'[date], MAX ( 'open_data_logement dim_date'[date] ), -12, MONTH )
)

Nb ventes cumul annuel =
TOTALYTD ( [Nb ventes], 'open_data_logement dim_date'[date] )


// ---------------------------------------------------------------------
//  PERFORMANCE ÉNERGÉTIQUE ('open_data_logement fct_dpe_mensuel')
// ---------------------------------------------------------------------

Nb DPE =
SUM ( 'open_data_logement fct_dpe_mensuel'[nb_dpe] )

Nb passoires thermiques =
CALCULATE ( [Nb DPE], 'open_data_logement fct_dpe_mensuel'[est_passoire_thermique] = TRUE () )

// Additif : juste quel que soit le filtre
Part passoires thermiques =
DIVIDE ( [Nb passoires thermiques], [Nb DPE] )

Part passoires N-1 =
IF (
    NOT ISBLANK ( [Part passoires thermiques] ),
    CALCULATE ( [Part passoires thermiques], SAMEPERIODLASTYEAR ( 'open_data_logement dim_date'[date] ) )
)

// En points de pourcentage (ex. -0,05 = -5 points)
// Soustraction (et non DIVIDE) : si la N-1 est vide, DAX la traite comme 0.
// On exige donc explicitement une N-1 non vide (sinon 2021 afficherait +18,4 pts).
Écart passoires vs N-1 (pts) =
IF (
    HASONEVALUE ( 'open_data_logement dim_date'[annee] )
        && NOT ISBLANK ( [Part passoires N-1] ),
    [Part passoires thermiques] - [Part passoires N-1]
)

Part logements A-B =
DIVIDE (
    CALCULATE ( [Nb DPE], 'open_data_logement fct_dpe_mensuel'[etiquette_dpe] IN { "A", "B" } ),
    [Nb DPE]
)


// ---------------------------------------------------------------------
//  ACCESSIBILITÉ (croisement ventes × revenus)
// ---------------------------------------------------------------------

// Niveau de vie médian de la commune sélectionnée (vide si plusieurs communes :
// une médiane de médianes n'a pas de sens)
Niveau de vie médian =
SELECTEDVALUE ( 'open_data_logement dim_commune'[niveau_vie_median] )

// Nombre d'années de niveau de vie médian pour acheter le logement médian
Années de niveau de vie pour acheter =
DIVIDE ( [Prix médian], [Niveau de vie médian] )


// ---------------------------------------------------------------------
//  AFFICHAGE
// ---------------------------------------------------------------------

// Titre dynamique : « Période : 2021 – 2025 »
Titre période =
"Période : " & YEAR ( MIN ( 'open_data_logement fct_ventes'[date_vente] ) ) & " – " & YEAR ( MAX ( 'open_data_logement fct_ventes'[date_vente] ) )

Dernière vente connue =
FORMAT ( MAX ( 'open_data_logement fct_ventes'[date_vente] ), "d mmmm yyyy" )


// ---------------------------------------------------------------------
//  LIBELLÉS DES CARTES (page 1)
//  Le segment Année n'existe que sur la page 1 : c'est un segment normal
//  sur 'open_data_logement dim_date'[annee], et les mesures N-1 (SAMEPERIODLASTYEAR) suffisent.
// ---------------------------------------------------------------------

// « ▲ +12,9 % vs 2024 » : à utiliser en étiquette de référence de la carte
// (dans FORMAT, le séparateur décimal s'écrit toujours « . » ; Power BI
//  affiche ensuite la virgule selon les paramètres régionaux français)
Libellé évol. ventes =
VAR e = [Évol. ventes vs N-1]
RETURN
    IF (
        NOT ISBLANK ( e ),
        IF ( e >= 0, "▲ ", "▼ " ) & FORMAT ( e, "+0.0 %;-0.0 %" ) & " vs " & ( MAX ( 'open_data_logement dim_date'[annee] ) - 1 )
    )

Libellé évol. prix m² =
VAR e = [Évol. prix m² vs N-1]
RETURN
    IF (
        NOT ISBLANK ( e ),
        IF ( e >= 0, "▲ ", "▼ " ) & FORMAT ( e, "+0.0 %;-0.0 %" ) & " vs " & ( MAX ( 'open_data_logement dim_date'[annee] ) - 1 )
    )

// « ▲ +0,7 pts vs 2024 » : l'écart est une différence de parts, affichée en points
Libellé écart passoires =
VAR e = [Écart passoires vs N-1 (pts)]
RETURN
    IF (
        NOT ISBLANK ( e ),
        IF ( e >= 0, "▲ ", "▼ " ) & FORMAT ( e * 100, "+0.0;-0.0" ) & " pts vs " & ( MAX ( 'open_data_logement dim_date'[annee] ) - 1 )
    )

// Couleur du libellé : vert si hausse, rouge si baisse (fx → Valeur du champ)
Couleur évol. ventes =
IF ( [Évol. ventes vs N-1] >= 0, "#1D7A3A", "#B3261E" )

Couleur évol. prix m² =
IF ( [Évol. prix m² vs N-1] >= 0, "#1D7A3A", "#B3261E" )

// Pour les passoires, une baisse est une bonne nouvelle : couleurs inversées
Couleur écart passoires =
IF ( [Écart passoires vs N-1 (pts)] <= 0, "#1D7A3A", "#B3261E" )

// Étiquette « -22 % » sous chaque colonne de l'histogramme annuel (page 2)
Libellé évol. ventes vs N-1 =
FORMAT ( [Évol. ventes vs N-1], "+0 %;-0 %" )


// =====================================================================
//  VARIANTE OPTIONNELLE : SEGMENT ANNÉE DÉCONNECTÉ
//  À utiliser seulement si tu veux qu'un graphique garde TOUTES les années
//  tout en mettant l'année choisie en évidence (ex. ventes mensuelles
//  2021 → 2025 avec l'année choisie en bleu foncé).
//
//  1. Modélisation → Nouvelle table :
//       Années = VALUES ( 'open_data_logement dim_date'[annee] )
//     Ne crée AUCUNE relation avec cette table.
//  2. Le segment Année pointe sur Années[annee] (sélection unique).
//  3. Les cartes utilisent les mesures « (année choisie) » ci-dessous.
// =====================================================================

Année choisie =
SELECTEDVALUE ( Années[annee], 2025 )

Année précédente =
[Année choisie] - 1


// --- Marché : année choisie vs année précédente ------------------------

Nb ventes (année choisie) =
CALCULATE ( [Nb ventes], TREATAS ( { [Année choisie] }, 'open_data_logement dim_date'[annee] ) )

Nb ventes (année précédente) =
CALCULATE ( [Nb ventes], TREATAS ( { [Année précédente] }, 'open_data_logement dim_date'[annee] ) )

Évol. ventes (année choisie) =
DIVIDE ( [Nb ventes (année choisie)] - [Nb ventes (année précédente)], [Nb ventes (année précédente)] )

Prix m² médian (année choisie) =
CALCULATE ( [Prix m² médian], TREATAS ( { [Année choisie] }, 'open_data_logement dim_date'[annee] ) )

Prix m² médian (année précédente) =
CALCULATE ( [Prix m² médian], TREATAS ( { [Année précédente] }, 'open_data_logement dim_date'[annee] ) )

Évol. prix m² (année choisie) =
DIVIDE ( [Prix m² médian (année choisie)] - [Prix m² médian (année précédente)], [Prix m² médian (année précédente)] )

Prix médian (année choisie) =
CALCULATE ( [Prix médian], TREATAS ( { [Année choisie] }, 'open_data_logement dim_date'[annee] ) )


// --- Énergie : année choisie ------------------------------------------

Nb DPE (année choisie) =
CALCULATE ( [Nb DPE], TREATAS ( { [Année choisie] }, 'open_data_logement dim_date'[annee] ) )

Part passoires (année choisie) =
CALCULATE ( [Part passoires thermiques], TREATAS ( { [Année choisie] }, 'open_data_logement dim_date'[annee] ) )

Part passoires (année précédente) =
CALCULATE ( [Part passoires thermiques], TREATAS ( { [Année précédente] }, 'open_data_logement dim_date'[annee] ) )

// En points (ex. -0,05 = -5 points) ; une baisse est une bonne nouvelle
Écart passoires (pts) =
[Part passoires (année choisie)] - [Part passoires (année précédente)]


// --- Couleurs dynamiques ----------------------------------------------

// Met en évidence l'année choisie dans les histogrammes et mini-courbes
// (fx → Valeur du champ, sur un visuel dont l'axe porte 'open_data_logement dim_date')
Couleur année choisie =
IF ( MAX ( 'open_data_logement dim_date'[annee] ) = [Année choisie], "#2A78D6", "#B7D3F6" )

// =====================================================================
//  ACCESSIBILITÉ ET TABLEAU DES COMMUNES
// =====================================================================

// Trois tranches pour colorer le nuage de points
// (Marqueurs → Couleur → fx → Valeur du champ)
Couleur accessibilité =
VAR a = [Années de niveau de vie pour acheter]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( a ), BLANK (),
        a < 5, "#86B6EF",
        a < 8, "#2A78D6",
        "#104281"
    )

// Médiane sur les communes (pour les cartes de la page Accessibilité)
Années pour acheter · commune médiane =
MEDIANX (
    FILTER ( VALUES ( 'open_data_logement dim_commune'[code_commune] ), [Nb ventes] >= 10 ),
    [Années de niveau de vie pour acheter]
)

Communes à 8 ans ou plus =
COUNTROWS (
    FILTER (
        VALUES ( 'open_data_logement dim_commune'[code_commune] ),
        [Nb ventes] >= 10 && [Années de niveau de vie pour acheter] >= 8
    )
)

Niveau de vie · commune médiane =
MEDIANX ( VALUES ( 'open_data_logement dim_commune'[code_commune] ), [Niveau de vie médian] )

// Évolution entre deux périodes fixes, pour le tableau des communes
Prix m² médian 2021-2022 =
CALCULATE ( [Prix m² médian], 'open_data_logement dim_date'[annee] IN { 2021, 2022 } )

Prix m² médian 2024-2025 =
CALCULATE ( [Prix m² médian], 'open_data_logement dim_date'[annee] IN { 2024, 2025 } )

Évol. prix m² 2021-22 → 2024-25 =
DIVIDE ( [Prix m² médian 2024-2025] - [Prix m² médian 2021-2022], [Prix m² médian 2021-2022] )
