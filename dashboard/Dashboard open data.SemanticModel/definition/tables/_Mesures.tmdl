	measure 'Niveau de vie médian' =
			
			SELECTEDVALUE ( 'open_data_logement dim_commune'[niveau_vie_median] )
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: 3. Accessibilité
