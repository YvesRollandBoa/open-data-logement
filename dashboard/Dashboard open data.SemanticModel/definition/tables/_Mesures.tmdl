	measure 'Couleur accessibilité' =
			
			VAR a = [Années de niveau de vie pour acheter]
			RETURN
			    SWITCH ( TRUE (), a >= 8, "#B3261E", a >= 6, "#E58606", "#1D7A3A" )
		displayFolder: 9. Mise en forme
		lineageTag: 7e2b58af-a9a3-4424-8981-5860f5025e5d

	measure 'Années pour acheter · commune médiane' =
			
			MEDIANX (
			    FILTER ( VALUES ( 'open_data_logement dim_commune'[code_commune] ), [Nb ventes] >= 10 ),
			    [Années de niveau de vie pour acheter]
			)
		formatString: 0.0
		displayFolder: 3. Accessibilité
		lineageTag: 4786f927-29b9-401e-bc79-63b0950f11e6

	measure 'Communes à 8 ans ou plus' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( 'open_data_logement dim_commune'[code_commune] ),
			        [Nb ventes] >= 10 && [Années de niveau de vie pour acheter] >= 8
			    )
			)
		formatString: 0
		displayFolder: 3. Accessibilité
		lineageTag: 6508f5f9-5de7-43e1-8798-929c02a4f0a1

	measure 'Niveau de vie · commune médiane' =
			
