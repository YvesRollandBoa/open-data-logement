	measure 'Évol. prix m² 2021-22 → 2024-25' =
			
			DIVIDE ( [Prix m² médian 2024-2025] - [Prix m² médian 2021-2022], [Prix m² médian 2021-2022] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
