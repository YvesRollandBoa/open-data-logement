		lineageTag: f4760e45-eef3-4622-b308-30370425847f

	measure 'Prix m² médian (30 ventes ou plus)' =
			
			IF ( [Nb ventes] >= 30, [Prix m² médian] )
		displayFolder: 1. Marché
