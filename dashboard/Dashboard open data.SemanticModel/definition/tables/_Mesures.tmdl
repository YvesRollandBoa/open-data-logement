	measure 'Évol. prix m² (30 ventes ou plus)' =
			
			VAR nDebut =
			    CALCULATE ( [Nb ventes], 'open_data_logement dim_date'[annee] IN { 2021, 2022 } )
			VAR nFin =
			    CALCULATE ( [Nb ventes], 'open_data_logement dim_date'[annee] IN { 2024, 2025 } )
			RETURN
			    IF ( nDebut >= 30 && nFin >= 30, [Évol. prix m² 2021-22 → 2024-25] )
		displayFolder: 1. Marché\Comparaison N-1
		lineageTag: 796f98b5-331e-4777-a385-227847af64fe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

